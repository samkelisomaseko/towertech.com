# ---- Server ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgres://towertech:towertech@localhost:5432/towertech

# ---- Auth / Security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-hex-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=1

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# ---- Seed / Bootstrap ----
ADMIN_EMAIL=admin@towertech.com
# In production this MUST be changed from the dev default.
ADMIN_PASSWORD=towertechIT31A

# ---- Payments (Stripe — test mode keys) ----
# Required in production.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Payments (MTN MoMo Collection API — Eswatini) ----
# Get sandbox/production credentials from https://momodeveloper.mtn.com
MOMO_COLLECTION_URL=https://sandbox.momodeveloper.mtn.com/collection
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CALLBACK_URL=https://your-app.example.com/api/payments/webhook/momo

# ---- Payments (InstaCash) ----
# InstaCash has no public API spec; wire the merchant-provided endpoint + key here
# or manage both at runtime from the admin panel.
INSTACASH_ENDPOINT=
INSTACASH_API_KEY=

# ---- Email (SMTP). Required in production. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TowerTech <no-reply@towertech.sz>"

# ---- Notifications ----
NOTIFY_CONTACT_EMAIL=contact@towertech.sz
NOTIFY_BUGS_EMAIL=bugs@towertech.sz
