# ---- Server ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgres://towertech:towertech@localhost:5432/towertech

# ---- Auth / Security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do not use a placeholder value: JWT_SECRET must contain at least 48 random characters.
JWT_SECRET=replace-me-with-at-least-48-random-characters-000
JWT_EXPIRES_IN=7d
JWT_ISSUER=towertech
JWT_AUDIENCE=towertech-app
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=1

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- Database bootstrap ----
# Production Compose sets both to false and runs migrations/seed as explicit deploy steps.
DB_AUTO_MIGRATE=true
DB_AUTO_SEED=true

# ---- Seed / Bootstrap ----
ADMIN_EMAIL=admin@towertech.com
# Required. Use at least 12 characters and never reuse the published development password.
ADMIN_PASSWORD=replace-me-with-a-strong-admin-password

# ---- Payments (Stripe — test mode keys) ----
# Required in production.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Payments (MTN MoMo Collection API — Eswatini) ----
# Get sandbox/production credentials from https://momodeveloper.mtn.com
MOMO_COLLECTION_URL=https://sandbox.momodeveloper.mtn.com/collection
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CALLBACK_URL=https://your-app.example.com/api/payments/webhook/momo

# ---- Payments (InstaCash) ----
# InstaCash has no public API spec; configure the merchant-provided endpoint and key here.
INSTACASH_ENDPOINT=
INSTACASH_API_KEY=

# ---- Email (SMTP). Required in production. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TowerTech <no-reply@towertech.sz>"

# ---- Notifications ----
NOTIFY_CONTACT_EMAIL=contact@towertech.sz
NOTIFY_BUGS_EMAIL=bugs@towertech.sz
